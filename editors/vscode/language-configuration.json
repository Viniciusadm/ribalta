{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["*", "*"],
    ["`", "`"],
    ["~", "~"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*:::\\s*[\\w-]+",
      "end": "^\\s*:::\\s*$"
    }
  },
  "wordPattern": "[\\w-]+"
}
