{
  "name": "ribalta-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-content": "node scripts/link-content.mjs && vite build --config render.config.ts",
    "dev": "npm run wasm -w @ribaltalang/compiler --prefix .. && npm run prepare-content && astro dev",
    "build": "npm run wasm -w @ribaltalang/compiler --prefix .. && npm run prepare-content && astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ribaltalang/compiler": "*",
    "@ribaltalang/renderer": "*",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
