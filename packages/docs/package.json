{
  "name": "@ribaltalang/docs",
  "version": "0.2.0",
  "description": "Documentation of the Ribalta language as Markdown pages, in Portuguese and English (en/), for sites that host them.",
  "keywords": [
    "ribalta",
    "documentation",
    "language"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "viniciusam",
  "homepage": "https://folioslides.com.br/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viniciusadm/ribalta.git",
    "directory": "packages/docs"
  },
  "bugs": "https://github.com/Viniciusadm/ribalta/issues",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "pages",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "rm -rf pages && cp -r ../../docs pages",
    "prepack": "npm run build && cp ../../LICENSE-MIT ../../LICENSE-APACHE ."
  },
  "publishConfig": {
    "access": "public"
  }
}
