[
  { "expr": "$a + 1", "values": { "a": 3 }, "expected": "4" },
  { "expr": "$a * 2 + $b", "values": { "a": 3, "b": 1.5 }, "expected": "7.5" },
  { "expr": "$a / 4", "values": { "a": 3 }, "expected": "0.75" },
  { "expr": "$a % 4", "values": { "a": 10 }, "expected": "2" },
  { "expr": "-$a", "values": { "a": 3 }, "expected": "-3" },
  { "expr": "0.1 + $a", "values": { "a": 0.2 }, "expected": "0.30000000000000004" },
  { "expr": "round($a)", "values": { "a": 2.5 }, "expected": "3" },
  { "expr": "round($a)", "values": { "a": -2.5 }, "expected": "-3" },
  { "expr": "round($a, 2)", "values": { "a": 3.14159 }, "expected": "3.14" },
  { "expr": "min($a, 4)", "values": { "a": 7 }, "expected": "4" },
  { "expr": "max($a, 4, 9)", "values": { "a": 7 }, "expected": "9" },
  { "expr": "\"R$ \" + $a", "values": { "a": 49 }, "expected": "R$ 49" },
  { "expr": "$t + \"!\"", "values": { "t": "oi" }, "expected": "oi!" },
  { "expr": "$t + $a", "values": { "t": "x", "a": 2.5 }, "expected": "x2.5" },
  { "expr": "$a > 2", "values": { "a": 3 }, "expected": "true" },
  { "expr": "$a <= 2", "values": { "a": 3 }, "expected": "false" },
  { "expr": "$t == pro", "values": { "t": "pro" }, "expected": "true" },
  { "expr": "$t != pro", "values": { "t": "pro" }, "expected": "false" },
  { "expr": "$t < b", "values": { "t": "a" }, "expected": "true" },
  { "expr": "$p and not $q", "values": { "p": true, "q": false }, "expected": "true" },
  { "expr": "$p or $q", "values": { "p": false, "q": false }, "expected": "false" },
  { "expr": "!$p", "values": { "p": true }, "expected": "false" },
  { "expr": "$p ? sim : não", "values": { "p": true }, "expected": "sim" },
  { "expr": "$a > 1 ? $a * 10 : 0", "values": { "a": 2 }, "expected": "20" },
  { "expr": "($a + 1) * 2", "values": { "a": 1 }, "expected": "4" },
  { "expr": "$a * 1000000", "values": { "a": 12 }, "expected": "12000000" },
  { "expr": "len($l)", "values": { "l": ["a", "b", "c"] }, "expected": "3" },
  { "expr": "len($l) + 1", "values": { "l": [] }, "expected": "1" },
  { "expr": "b in $l", "values": { "l": ["a", "b"] }, "expected": "true" },
  { "expr": "c in $l", "values": { "l": ["a", "b"] }, "expected": "false" },
  { "expr": "not (c in $l)", "values": { "l": ["a"] }, "expected": "true" },
  { "expr": "$t in [pro, team]", "values": { "t": "team" }, "expected": "true" },
  { "expr": "$t in [pro, team]", "values": { "t": "basic" }, "expected": "false" },
  { "expr": "$l", "values": { "l": ["mapa", "chave"] }, "expected": "mapa, chave" },
  { "expr": "\"Itens: \" + len($l)", "values": { "l": ["a", "b"] }, "expected": "Itens: 2" }
]
